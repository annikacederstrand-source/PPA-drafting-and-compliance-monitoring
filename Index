<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FERVO — PPA Intelligence Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080c14;
    --surface: #0d1420;
    --surface-2: #131d2e;
    --border: #1e2d45;
    --border-bright: #2a3f5f;
    --amber: #e8a020;
    --amber-dim: #7a520f;
    --amber-glow: rgba(232,160,32,0.12);
    --teal: #1fbfaa;
    --teal-dim: rgba(31,191,170,0.15);
    --red: #e05252;
    --red-dim: rgba(224,82,82,0.12);
    --green: #3ecf8e;
    --green-dim: rgba(62,207,142,0.12);
    --text: #c8d8ec;
    --text-dim: #5a7a9a;
    --text-faint: #2a3f5f;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 300;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Grid background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.25;
    pointer-events: none;
    z-index: 0;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 56px;
    background: rgba(8,12,20,0.95);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 32px;
    gap: 40px;
    z-index: 100;
    backdrop-filter: blur(12px);
  }

  .nav-brand {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.12em;
    color: var(--amber);
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav-brand span {
    color: var(--text-dim);
    font-weight: 400;
  }

  .nav-links {
    display: flex;
    gap: 4px;
    list-style: none;
  }

  .nav-links a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 3px;
    transition: all 0.15s;
    text-transform: uppercase;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav-links a.active {
    color: var(--amber);
    border: 1px solid var(--amber-dim);
  }

  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    animation: pulse 2.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .status-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  /* LAYOUT */
  .page {
    position: relative;
    z-index: 1;
    padding: 80px 32px 48px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* PAGE HEADER */
  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-family: 'Syne', sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: #fff;
    line-height: 1;
    margin-bottom: 8px;
  }

  .page-subtitle {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.08em;
  }

  .timestamp {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--text-faint);
    text-align: right;
    line-height: 1.8;
  }

  /* KPI STRIP */
  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }

  .kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 20px 24px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .kpi-card:hover { border-color: var(--border-bright); }

  .kpi-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
  }

  .kpi-card.amber::before { background: var(--amber); }
  .kpi-card.teal::before { background: var(--teal); }
  .kpi-card.red::before { background: var(--red); }
  .kpi-card.green::before { background: var(--green); }

  .kpi-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .kpi-value {
    font-family: 'Syne', sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: #fff;
    line-height: 1;
    margin-bottom: 6px;
  }

  .kpi-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--text-dim);
  }

  .kpi-delta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    margin-top: 8px;
  }

  .kpi-delta.up { color: var(--green); }
  .kpi-delta.down { color: var(--red); }

  /* GRID 2-COL */
  .grid-2 {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }

  /* PANEL */
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }

  .panel-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .panel-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    padding: 2px 8px;
    border-radius: 2px;
    letter-spacing: 0.06em;
  }

  .badge-amber { background: var(--amber-glow); color: var(--amber); border: 1px solid var(--amber-dim); }
  .badge-red { background: var(--red-dim); color: var(--red); border: 1px solid rgba(224,82,82,0.3); }
  .badge-green { background: var(--green-dim); color: var(--green); border: 1px solid rgba(62,207,142,0.3); }
  .badge-teal { background: var(--teal-dim); color: var(--teal); border: 1px solid rgba(31,191,170,0.3); }

  .panel-body { padding: 20px; }

  /* PIPELINE TABLE */
  .pipeline-table {
    width: 100%;
    border-collapse: collapse;
  }

  .pipeline-table th {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    text-align: left;
    padding: 0 16px 12px;
    border-bottom: 1px solid var(--border);
  }

  .pipeline-table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(30,45,69,0.5);
    vertical-align: middle;
  }

  .pipeline-table tr:last-child td { border-bottom: none; }

  .pipeline-table tr {
    transition: background 0.15s;
    cursor: pointer;
  }

  .pipeline-table tr:hover td { background: var(--surface-2); }

  .proj-name {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
  }

  .proj-type {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--text-dim);
    margin-top: 2px;
  }

  .stage-pill {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .stage-negotiation { background: rgba(232,160,32,0.15); color: var(--amber); }
  .stage-review { background: rgba(31,191,170,0.12); color: var(--teal); }
  .stage-executed { background: rgba(62,207,142,0.12); color: var(--green); }
  .stage-compliance { background: rgba(100,120,160,0.15); color: #7a9abf; }

  .risk-bar-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .risk-bar {
    flex: 1;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }

  .risk-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.6s ease;
  }

  .risk-high .risk-fill { background: var(--red); }
  .risk-med .risk-fill { background: var(--amber); }
  .risk-low .risk-fill { background: var(--green); }

  .risk-pct {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--text-dim);
    width: 28px;
    text-align: right;
  }

  /* PHASE ROLLOUT */
  .phase-rollout {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 6px;
  }

  .phase-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .phase-node + .phase-node::before {
    content: '';
    position: absolute;
    right: 100%;
    top: 9px;
    width: 16px;
    height: 1px;
  }

  .phase-connector {
    width: 16px;
    height: 1px;
    background: var(--border);
    margin-top: 9px;
    flex-shrink: 0;
  }

  .phase-connector.done { background: var(--green); }
  .phase-connector.active { background: var(--amber); }

  .phase-dot {
    width: 18px; height: 18px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8px;
    font-weight: 500;
    flex-shrink: 0;
  }

  .phase-dot.online {
    background: var(--green-dim);
    color: var(--green);
    border: 1px solid rgba(62,207,142,0.4);
    box-shadow: 0 0 6px rgba(62,207,142,0.2);
  }

  .phase-dot.active {
    background: var(--amber-glow);
    color: var(--amber);
    border: 1px solid var(--amber-dim);
  }

  .phase-dot.future {
    background: var(--surface-2);
    color: var(--text-faint);
    border: 1px solid var(--border);
  }

  .phase-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8px;
    color: var(--text-faint);
    margin-top: 3px;
    white-space: nowrap;
  }

  .phase-label.online { color: var(--green); }
  .phase-label.active { color: var(--amber); }

  .project-row-main td {
    padding-bottom: 6px !important;
    border-bottom: none !important;
  }

  .project-row-phases td {
    padding-top: 0 !important;
    padding-bottom: 12px !important;
    border-bottom: 1px solid rgba(30,45,69,0.5);
  }

  .project-row-phases:last-child td { border-bottom: none !important; }

  .phase-row-cell {
    padding-left: 16px;
  }

  .project-separator td {
    padding: 0 !important;
    border-bottom: none !important;
    height: 0;
  }

  .total-mw {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    color: var(--teal);
    margin-top: 1px;
  }

  .cod-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8px;
    padding: 1px 6px;
    border-radius: 2px;
    background: var(--green-dim);
    color: var(--green);
    border: 1px solid rgba(62,207,142,0.3);
    margin-top: 3px;
  }

  .proj-tag {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8px;
    padding: 1px 6px;
    border-radius: 2px;
    margin-top: 3px;
    letter-spacing: 0.04em;
  }

  .proj-tag-egs {
    background: rgba(155,127,232,0.12);
    color: #9b7fe8;
    border: 1px solid rgba(155,127,232,0.25);
  }

  .proj-tag-brownfield {
    background: rgba(200,150,80,0.1);
    color: #c8a050;
    border: 1px solid rgba(200,150,80,0.25);
  }

  /* ACTIVITY FEED */
  .feed-item {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(30,45,69,0.5);
  }

  .feed-item:last-child { border-bottom: none; }

  .feed-icon {
    width: 28px; height: 28px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feed-icon.ferc { background: rgba(232,160,32,0.15); }
  .feed-icon.redline { background: rgba(31,191,170,0.12); }
  .feed-icon.compliance { background: rgba(62,207,142,0.12); }
  .feed-icon.alert { background: rgba(224,82,82,0.12); }

  .feed-content { flex: 1; }

  .feed-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 3px;
    line-height: 1.4;
  }

  .feed-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    color: var(--text-dim);
    letter-spacing: 0.04em;
  }

  /* KPI TRACK (30/60/90) */
  .kpi-track {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .track-item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .track-day {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--amber);
    width: 40px;
    flex-shrink: 0;
  }

  .track-detail { flex: 1; }

  .track-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--text-dim);
    margin-bottom: 6px;
  }

  .track-progress {
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }

  .track-fill {
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--amber), var(--teal));
    transition: width 0.8s ease;
  }

  .track-value {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    color: var(--text-dim);
    margin-top: 4px;
  }

  /* ACTION BUTTONS */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: 3px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s;
  }

  .btn-primary {
    background: var(--amber);
    color: #080c14;
    font-weight: 500;
  }

  .btn-primary:hover { background: #f0b030; }

  .btn-ghost {
    background: transparent;
    color: var(--text-dim);
    border: 1px solid var(--border);
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: var(--border-bright);
  }

  /* AGENT STATUS */
  .agent-status {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--teal);
    border-radius: 4px;
    padding: 16px 24px;
    margin-bottom: 20px;
  }

  .agent-icon {
    font-size: 22px;
    flex-shrink: 0;
  }

  .agent-info { flex: 1; }

  .agent-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--teal);
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .agent-desc {
    font-size: 12px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .agent-actions {
    display: flex;
    gap: 10px;
  }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  /* ANIMATION */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .page-header,
  .kpi-strip,
  .agent-status,
  .grid-2,
  .grid-3 {
    animation: fadeUp 0.4s ease both;
  }

  .kpi-strip { animation-delay: 0.05s; }
  .agent-status { animation-delay: 0.1s; }
  .grid-2 { animation-delay: 0.15s; }
  .grid-3 { animation-delay: 0.2s; }
</style>
</head>
