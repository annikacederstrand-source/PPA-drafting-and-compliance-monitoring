<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Post-COD Compliance — FERVO PPA Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080c14;
    --surface: #0d1420;
    --surface-2: #131d2e;
    --border: #1e2d45;
    --border-bright: #2a3f5f;
    --amber: #e8a020;
    --amber-dim: #7a520f;
    --amber-glow: rgba(232,160,32,0.12);
    --teal: #1fbfaa;
    --teal-dim: rgba(31,191,170,0.15);
    --red: #e05252;
    --red-dim: rgba(224,82,82,0.12);
    --green: #3ecf8e;
    --green-dim: rgba(62,207,142,0.12);
    --text: #c8d8ec;
    --text-dim: #5a7a9a;
    --text-faint: #2a3f5f;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 300;
    min-height: 100vh;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.2;
    pointer-events: none;
    z-index: 0;
  }

  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 56px;
    background: rgba(8,12,20,0.95);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 32px;
    gap: 40px;
    z-index: 100;
    backdrop-filter: blur(12px);
  }

  .nav-brand {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.12em;
    color: var(--amber);
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav-brand span { color: var(--text-dim); font-weight: 400; }
  .nav-links { display: flex; gap: 4px; list-style: none; }

  .nav-links a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 3px;
    transition: all 0.15s;
    text-transform: uppercase;
  }

  .nav-links a:hover,
  .nav-links a.active { color: var(--text); background: var(--surface-2); }
  .nav-links a.active { color: var(--amber); border: 1px solid var(--amber-dim); }
  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 16px; }

  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    animation: pulse 2.5s infinite;
  }

  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  .status-label { font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: var(--text-dim); }

  .page {
    position: relative;
    z-index: 1;
    padding: 72px 32px 48px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-family: 'Syne', sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 6px;
  }

  .page-subtitle {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.08em;
  }

  /* PROJECT SELECTOR */
  .project-selector {
    display: flex;
    gap: 12px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .proj-card {
    flex: 1;
    min-width: 180px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 14px 18px;
    cursor: pointer;
    transition: all 0.15s;
    position: relative;
    overflow: hidden;
  }

  .proj-card:hover { border-color: var(--border-bright); }

  .proj-card.selected {
    border-color: var(--amber);
    background: var(--surface-2);
  }

  .proj-card::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--border);
  }

  .proj-card.selected::after { background: var(--amber); }
  .proj-card.on-track::after { background: var(--green); }
  .proj-card.warning::after { background: var(--amber); }
  .proj-card.breach::after { background: var(--red); }

  .proj-card-name {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 3px;
  }

  .proj-card-type {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    color: var(--text-dim);
    margin-bottom: 10px;
  }

  .proj-card-compliance {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .compliance-ring {
    position: relative;
    width: 36px; height: 36px;
    flex-shrink: 0;
  }

  .compliance-ring svg { transform: rotate(-90deg); }

  .compliance-ring circle {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .compliance-track { stroke: var(--border); }

  .compliance-fill-green { stroke: var(--green); }
  .compliance-fill-amber { stroke: var(--amber); }
  .compliance-fill-red { stroke: var(--red); }

  .compliance-pct {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8px;
    font-weight: 500;
    color: var(--text);
  }

  .proj-card-stats {
    flex: 1;
  }

  .proj-stat {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    color: var(--text-dim);
    margin-bottom: 2px;
  }

  /* DETAIL LAYOUT */
  .detail-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 20px;
  }

  /* OBLIGATION TABLE */
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }

  .panel-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .panel-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    padding: 2px 8px;
    border-radius: 2px;
    letter-spacing: 0.06em;
  }

  .badge-green { background: var(--green-dim); color: var(--green); border: 1px solid rgba(62,207,142,0.3); }
  .badge-amber { background: var(--amber-glow); color: var(--amber); border: 1px solid var(--amber-dim); }
  .badge-red { background: var(--red-dim); color: var(--red); border: 1px solid rgba(224,82,82,0.3); }

  /* OBLIGATION ITEM */
  .ob-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(30,45,69,0.4);
    transition: background 0.15s;
    cursor: pointer;
  }

  .ob-item:hover { background: var(--surface-2); }
  .ob-item:last-child { border-bottom: none; }

  .ob-check {
    width: 22px; height: 22px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 12px;
    margin-top: 2px;
  }

  .ob-check.done { background: var(--green-dim); color: var(--green); border: 1px solid rgba(62,207,142,0.3); }
  .ob-check.overdue { background: var(--red-dim); color: var(--red); border: 1px solid rgba(224,82,82,0.3); }
  .ob-check.upcoming { background: var(--amber-glow); color: var(--amber); border: 1px solid var(--amber-dim); }
  .ob-check.future { background: var(--surface-2); color: var(--text-faint); border: 1px solid var(--border); }

  .ob-content { flex: 1; }

  .ob-id {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    color: var(--text-faint);
    margin-bottom: 3px;
    letter-spacing: 0.06em;
  }

  .ob-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 4px;
  }

  .ob-description {
    font-size: 11px;
    color: var(--text-dim);
    line-height: 1.5;
    margin-bottom: 6px;
  }

  .ob-meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ob-meta-item {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    color: var(--text-faint);
  }

  .ob-meta-item.highlight { color: var(--amber); }
  .ob-meta-item.overdue-text { color: var(--red); }
  .ob-meta-item.done-text { color: var(--green); }

  .ob-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex-shrink: 0;
  }

  .ob-due {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    text-align: right;
    line-height: 1.6;
  }

  .btn-sm {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 2px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .btn-sm:hover { color: var(--text); border-color: var(--border-bright); }
  .btn-sm.submit { border-color: var(--green); color: var(--green); }
  .btn-sm.submit:hover { background: var(--green-dim); }
  .btn-sm.urgent { border-color: var(--red); color: var(--red); }

  /* TIMELINE */
  .timeline {
    padding: 20px;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 35px;
    top: 24px;
    bottom: 24px;
    width: 1px;
    background: var(--border);
  }

  .tl-item {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
    position: relative;
  }

  .tl-item:last-child { margin-bottom: 0; }

  .tl-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
    position: relative;
    z-index: 1;
  }

  .tl-dot.done { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .tl-dot.upcoming { background: var(--amber); }
  .tl-dot.future { background: var(--border); }

  .tl-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    color: var(--text-faint);
    width: 65px;
    flex-shrink: 0;
    margin-top: 4px;
    text-align: right;
  }

  .tl-content { flex: 1; }

  .tl-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 2px;
  }

  .tl-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    color: var(--text-dim);
  }

  /* RIGHT SIDEBAR */
  .sidebar-right { }

  .info-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .info-header {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .info-body { padding: 16px; }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid rgba(30,45,69,0.4);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
  }

  .info-row:last-child { border-bottom: none; }
  .info-key { color: var(--text-dim); }
  .info-val { color: var(--text); text-align: right; }
  .info-val.green { color: var(--green); }
  .info-val.amber { color: var(--amber); }
  .info-val.red { color: var(--red); }

  .obligation-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 16px;
  }

  .ob-sum-box {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 12px;
    text-align: center;
  }

  .ob-sum-val {
    font-family: 'Syne', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #fff;
    line-height: 1;
    margin-bottom: 4px;
  }

  .ob-sum-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8px;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .project-selector,
  .detail-layout { animation: fadeUp 0.3s ease both; }
  .detail-layout { animation-delay: 0.1s; }

  ::-webkit-scrollbar { width: 3px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
</style>
</head>
