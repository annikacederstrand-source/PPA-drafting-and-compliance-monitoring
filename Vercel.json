{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/shadow-redline", "dest": "/shadow-redline.html" },
    { "src": "/regulatory-feed", "dest": "/regulatory-feed.html" },
    { "src": "/compliance", "dest": "/compliance.html" },
    { "src": "/(.*)\\.html", "dest": "/$1.html" }
  ]
}
